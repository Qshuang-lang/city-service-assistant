# ========================================
# 城市公共服务智能助手 - 配置文件
# ========================================

# 阿里DashScope通义千问API Key（用于LLM）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 和风天气API Key
QWEATHER_API_KEY=your_qweather_api_key_here
# 和风天气Host（免费用户为分配域名，例如 https://xxx.re.qweatherapi.com，会自动补全 /v7）
QWEATHER_HOST=https://devapi.qweather.com/v7
# 和风空气质量 API（新版 Web API v1）JWT 认证 Token（可选）
# 说明：和风 Web API v7 的 /v7/air/now 已于 2026-06-01 停服（403），
# 新版接口为 /airquality/v1/daily/{lat}/{lon}，需在控制台生成 JWT 并开通空气质量订阅。
# 未配置时空气质量自动由种子数据兜底（simulated）。
QWEATHER_AIR_JWT=your_qweather_air_jwt_here

# 高德地图API Key
AMAP_KEY=your_amap_api_key_here

# 腾讯地图API Key（备用）
QQ_MAP_KEY=your_qq_map_api_key_here

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=csp_db

# Milvus向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 服务端口配置
API_SERVER_PORT=8080
MCP_WEATHER_PORT=8002
MCP_TRAFFIC_PORT=8001
MCP_LIFE_PORT=8003
A2A_WEATHER_PORT=5005
A2A_TRAFFIC_PORT=5006
A2A_LIFE_PORT=5007
